# Local development
ENVIRONMENT=development

# Comma-separated browser origins allowed to call the API
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Optional: override default paths
# KNOWLEDGE_PATH=../knowledge/wementors_kb.json
# DATABASE_PATH=./data/chatbot.db

# Optional OpenAI layer for more natural phrasing.
# The chatbot works without this key using local retrieval + answer templates.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT_SECONDS=12

# Safety and retrieval
MAX_MESSAGE_LENGTH=2000
HISTORY_LIMIT=16
RETRIEVE_TOP_K=4
MIN_RELEVANCE_SCORE=4.0
RATE_LIMIT_REQUESTS=40
RATE_LIMIT_WINDOW_SECONDS=60
