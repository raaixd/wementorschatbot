# Copy to backend/.env (git-ignored) and adjust. Never commit real keys.
# Everything is optional: with no key, the bot answers from the knowledge base.

# --- Model -------------------------------------------------------------------
# The first key present is used, in this order: Gemini, Groq, Anthropic.
# Force one with LLM_PROVIDER=gemini | groq | anthropic | none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Needs: pip install anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# full_kb: fixed rules, then the model with the whole knowledge base
# routed:  keyword routing and retrieval choose what the model sees
ANSWER_MODE=full_kb

LLM_TIMEOUT_SECONDS=15
LLM_MAX_TOKENS=600
LLM_TEMPERATURE=0.3
LLM_HISTORY_TURNS=6

# --- Retrieval (routed mode) -------------------------------------------------
HYBRID_RETRIEVAL_ENABLED=false
RETRIEVAL_TOP_K=3
RETRIEVAL_CONFIDENCE_THRESHOLD=0.12

# --- Server ------------------------------------------------------------------
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
# Relative paths are resolved from the project root.
DATABASE_PATH=backend/data/chatbot.db
KNOWLEDGE_FILE=knowledge/wementors_kb.json
MAX_HISTORY_MESSAGES=20
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
# Leave blank to disable /admin/analytics
ADMIN_API_KEY=
LOG_LEVEL=INFO
