# Copy this file to .env in the chatbot-backend/ folder and adjust as needed.
# .env is already git-ignored and must never be committed.

# --- CORS ---
# Comma-separated list of allowed origins for the frontend. Update this to
# your real deployed website origin(s) in production.
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# --- Database ---
# Path to the SQLite database file (created automatically on first run).
# Relative paths are resolved against the project root, not your
# current directory, so this works from anywhere.
DATABASE_PATH=chatbot-backend/data/chatbot.db

# --- Knowledge base ---
KNOWLEDGE_FILE=knowledge/wementors_kb.json

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# --- Conversation ---
MAX_HISTORY_MESSAGES=20

# --- Retrieval ---
RETRIEVAL_TOP_K=3
RETRIEVAL_CONFIDENCE_THRESHOLD=0.12

# --- Optional LLM answer generation ---
# The chatbot works fully WITHOUT any of these: with no key set it answers
# from the knowledge base using deterministic templates (no network calls).
# Set ONE provider key to get more natural, conversational phrasing.
#
# Provider is auto-detected: GROQ_API_KEY wins, then ANTHROPIC_API_KEY.
# Set LLM_PROVIDER explicitly to force one ("groq", "anthropic", "none").

# Groq (OpenAI-compatible API) -- requires: pip install openai
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Anthropic -- requires: pip install anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# LLM_PROVIDER=groq
LLM_TIMEOUT_SECONDS=15
LLM_MAX_TOKENS=600
LLM_TEMPERATURE=0.3
# Prior conversation turns replayed to the model so follow-ups resolve.
LLM_HISTORY_TURNS=6

# --- Admin analytics endpoint ---
# Leave blank to disable /admin/analytics entirely.
ADMIN_API_KEY=

# --- Logging ---
LOG_LEVEL=INFO
